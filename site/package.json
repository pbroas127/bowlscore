{
  "name": "bowlscore-site",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "prebuild": "node scripts/assets.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "node --experimental-strip-types src/lib/rubric.test.ts && node --experimental-strip-types src/lib/openpetfoodfacts.test.ts && node --experimental-strip-types src/lib/catalog.test.ts && node --experimental-strip-types src/lib/recalls.test.ts",
    "check:dashes": "node --experimental-strip-types scripts/check-dashes.mjs",
    "catalog": "node --env-file=../.env scripts/build-catalog.mjs && node scripts/fetch-product-images.mjs"
  },
  "dependencies": {
    "jose": "^6.2.12",
    "motion": "^13.4.0",
    "next": "16.3.5",
