# Google AI Studio key for label reading. Without it, photo scans return 503 not_configured (barcode scans still work).
GEMINI_API_KEY=
# Optional. Defaults to gemini-3.5-flash-lite.
GEMINI_MODEL=
# Firebase project id. When set, /api/scan requires a Firebase ID token. Leave empty for local dev (no auth).
FIREBASE_PROJECT_ID=
