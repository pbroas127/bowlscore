default_platform(:ios)

APP_ID = "com.peterbroas.bowlscore".freeze
TEAM_ID = "GN2K85HBR8".freeze
PROFILE = "match AppStore #{APP_ID}".freeze

platform :ios do
  desc "Build, sign, and upload to TestFlight"
  lane :beta do
    setup_ci

    api_key = app_store_connect_api_key(
      key_id: ENV.fetch("ASC_KEY_ID"),
      issuer_id: ENV.fetch("ASC_ISSUER_ID"),
      key_content: ENV.fetch("ASC_KEY_P8")
    )

    match(
      type: "appstore",
      api_key: api_key,
      app_identifier: [APP_ID],
      readonly: false,
      # Set MATCH_FORCE=1 once after adding a capability, so the profile picks up the new entitlement.
      force: ENV["MATCH_FORCE"] == "1",
      force_for_new_devices: false
    )

    build_number = latest_testflight_build_number(
      api_key: api_key,
      app_identifier: APP_ID,
      initial_build_number: 0
    ) + 1

    # expo prebuild generates the project with automatic signing. CI has no Apple login, so switch to the match profile.
    update_code_signing_settings(
      use_automatic_signing: false,
      path: "app/ios/BowlScore.xcodeproj",
      team_id: TEAM_ID,
      bundle_identifier: APP_ID,
      profile_name: PROFILE,
      code_sign_identity: "Apple Distribution",
      targets: ["BowlScore"]
    )

    gym(
      workspace: "app/ios/BowlScore.xcworkspace",
      scheme: "BowlScore",
      export_method: "app-store",
      xcargs: "CURRENT_PROJECT_VERSION=#{build_number}",
      export_options: { provisioningProfiles: { APP_ID => PROFILE } }
    )

    pilot(
      api_key: api_key,
      skip_waiting_for_build_processing: true,
      distribute_external: false
    )
  end
end
